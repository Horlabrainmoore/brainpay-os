// MT5 Hedged Equity authentication

# Browser-publishable Thirdweb project client ID.
VITE_THIRDWEB_CLIENT_ID=

# Thirdweb server auth. Configure these only in Vercel/server environment variables.
THIRDWEB_SECRET_KEY=
THIRDWEB_AUTH_PRIVATE_KEY=
THIRDWEB_AUTH_DOMAIN=localhost:3000

# Existing integrations
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
