# .env.example
# Local dev env example - DO NOT COMMIT secrets
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=brainjetpay
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Appwrite web SDK configuration (project ID and endpoint are public client config)
VITE_APPWRITE_PROJECT_ID=6895d6ed0001f3af00fe
VITE_APPWRITE_PROJECT_NAME=BrainPay-Appwrite
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1

# Functions env (set these in Firebase console or via CLI)
MEMPOOL_API_BASE=https://mempool.space
MEMPOOL_RATE_LIMIT_KEY=

# CI secrets
FIREBASE_PROJECT_ID=brainjetpay
# FIREBASE_SERVICE_ACCOUNT should be stored in GitHub Secrets as base64 JSON
